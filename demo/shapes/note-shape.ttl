@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix cpcp: <https://w3id.org/laquereric/cpcp/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# Canonical NoteShape, version 1. Both demo CIDs embed this exact text
# (standalone portability) and check-shapes.py fails on divergence.
# Version: 1. Digest of the shape graph (excluding this comment block)
# is recorded in demo/SHAPES.json.
cpcp:NoteShape a sh:NodeShape ;
  sh:targetClass cpcp:Note ;
  sh:closed true ;
  sh:ignoredProperties ( rdf:type ) ;
  sh:property [ sh:path cpcp:title ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] ;
  sh:property [ sh:path cpcp:body ; sh:datatype xsd:string ; sh:minCount 1 ; sh:maxCount 1 ] .
